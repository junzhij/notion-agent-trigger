    {
      "$id": "admin-api",
      "name": "admin-api",
      "runtime": "node-22",
      "execute": ["any"],
      "events": [],
      "scopes": ["rows.read", "rows.write"],
      "schedule": "",
      "timeout": 20,
      "enabled": true,
      "logging": true,
      "entrypoint": "src/admin/main.js",
      "commands": "npm install --omit=dev",
      "path": "functions"
    }
